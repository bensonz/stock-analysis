.venv/
__pycache__/
*.pyc

# Large regenerable files in runs/ — keep input/, output/, and log.json tracked
# (both legacy runs/<date>/ and slotted runs/<date>/<slot>/ layouts)
runs/*/phase1.json
runs/*/prompt.md
runs/*/response.json
runs/*/*/phase1.json
runs/*/*/prompt.md
runs/*/*/response.json

# Generated deep-research articles (regenerable via scripts/research/deep_report.py),
# grouped as reports/<code>-<中文名>/ since 45c22b6
reports/

data/pricedb/

# secrets — never commit
.env
# Cached iFinD access token (derived from IFIND_REFRESH_TOKEN in .env, ~7d TTL).
# Regenerated on demand by scripts/ifind_client.py; written 0600.
data/ifind_token.json
# Derived SW level-1 industry membership cache (refreshed monthly from iFinD's
# ths_the_sw_industry_stock). Regenerable; see data_collector._load_sw_industry_map.
data/sw_industry_map.json

# Generated portfolio site — pure function of tracking/ + runs/ + data/index_cache/.
# Rebuilt on every run (and by `python3 scripts/build_site.py`); committing it
# added ~2 blobs of 180KB per trading day for an artifact nothing consumes.
site/
data/launchd/
data/ifind_option_chain.json
